# Base URL for the IAM backend. All accountApi requests are made relative to this.
VITE_API_BASE_URL=/api

# When true (default), accountApi serves realistic mock data instead of hitting
# the network — useful for running the UI before the backend is ready.
# Set to false once GET/PUT /api/users/me, /api/users/change-password,
# /api/users/security, and /api/activity are live.
VITE_USE_MOCKS=false
